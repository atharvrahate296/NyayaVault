# Application Environment
APP_ENV=development
APP_NAME=NyayaVault
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-app-secret-key-minimum-32-chars-here

# Relational Database (Supabase)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<pooler-host>:6543/<database-name>
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# JWT & Authentication Secrets
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (MinIO / S3)
STORAGE_PROVIDER=minio
# MinIO: http://localhost:9000. AWS S3: leave empty.
STORAGE_ENDPOINT=http://localhost:9000
# Browser-visible MinIO endpoint when the backend runs inside Docker.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=nyayavault-documents
STORAGE_BACKUP_BUCKET=nyayavault-canonical
STORAGE_REGION=us-east-1
STORAGE_SECURE=false
STORAGE_ADDRESSING_STYLE=path
STORAGE_CREATE_BUCKET=false
STORAGE_PRESIGNED_URL_TTL=300
# AWS S3 encryption: AES256 or aws:kms. Leave empty for local MinIO.
STORAGE_SSE=
STORAGE_KMS_KEY_ID=

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_DOCUMENTS=nyayavault_documents
QDRANT_COLLECTION_SECURITY=nyayavault_security
QDRANT_VECTOR_SIZE=384

# Task Queue & Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Integrity & Blockchain Layer
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=nyayavault-network
BLOCKCHAIN_CHANNEL=nyayavault-channel
BLOCKCHAIN_CHAINCODE=nyayavault-integrity
INTEGRITY_SECRET_KEY=your-integrity-sha256-salt-here

# AI, OCR & Vector Embedding Engines
AI_MODE=mock                        # Options: mock, local, cloud
AI_CONFIDENCE_THRESHOLD=70          # Percentage (0-100) or decimal threshold
OCR_ENGINE=mock                     # Options: mock, tesseract, easyocr
AI_MODEL_PATH=./models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# External API Credentials & LLM Services
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-api-key-here

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# File Upload Rules
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt